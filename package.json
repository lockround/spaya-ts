{
  "name": "spaya-ts",
  "version": "1.0.13",
  "description": "TypeScript client for Spaya retrosynthesis-scoring API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docs": "typedoc src/index.ts --out docs",
    "prepare": "npm run build",
    "publish": "node scripts/publish.js",
    "publish:patch": "node scripts/publish.js patch",
    "publish:minor": "node scripts/publish.js minor",
    "publish:major": "node scripts/publish.js major",
    "publish:beta": "node scripts/publish.js patch beta",
    "publish:dry-run": "node scripts/publish.js patch latest --dry-run",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version": "node scripts/version.js",
    "version:current": "node scripts/version.js current",
    "version:next": "node scripts/version.js next",
    "version:bump": "node scripts/version.js bump",
    "version:set": "node scripts/version.js set"
  },
  "keywords": [
    "spaya",
    "retrosynthesis",
    "chemistry",
    "api-client",
    "typescript"
  ],
  "author": "Iktos",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "jest": "^29.6.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iktos/spaya-ts.git"
  },
  "homepage": "https://github.com/iktos/spaya-ts#readme",
  "bugs": {
    "url": "https://github.com/iktos/spaya-ts/issues"
  }
}
